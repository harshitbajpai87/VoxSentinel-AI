# Keep the deployment upload small and intentional.
# Vercel uploads everything not ignored here; without this file the local
# node_modules (121 MB) and the training corpus were shipped on every deploy,
# which is what made the upload slow enough to time out.

# dependencies are installed on the build machine
frontend/node_modules
node_modules

# build output is regenerated by `npm run build --prefix frontend`
frontend/dist
frontend/.vite

# local caches and virtualenvs
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/*.pyc
.venv
venv

# version control and CLI state
.git
.vercel

# training / evaluation material: not needed at runtime, and large
training
evaluation
e2e
verification
backend/data
backend/models/*
# ...but the runtime model artifacts are required by the serverless function
!backend/models/*.joblib

# local scratch output
**/.voxsentinel_tmp
**/reports
*.log
