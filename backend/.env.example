# VoxSentinel AI backend — example environment configuration.
# Copy to .env (never commit it) and adjust. These placeholders contain no secrets.

VOXSENTINEL_ENV=development
VOXSENTINEL_API_VERSION=0.1.0
# Pipeline mode label only. It is NOT a readiness claim: /health.model_ready
# reports the real detector state.
VOXSENTINEL_APP_MODE=baseline

# SQLite for local development. Point at PostgreSQL in production if needed.
VOXSENTINEL_DB_URL=sqlite:///./voxsentinel.db

# Frontend origins allowed by CORS (comma-separated). No wildcard with credentials.
VOXSENTINEL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload and audio limits (independent of the frontend's own checks).
# 25 MB per FILE. The multipart envelope is not counted against it.
VOXSENTINEL_MAX_UPLOAD_BYTES=26214400
# Set this when a proxy/platform rejects bodies below 25 MB (Vercel: 4500000).
# The API then reports the smaller figure as the effective ceiling in /health
# and in every 413 message instead of claiming 25 MB.
VOXSENTINEL_HOSTING_BODY_LIMIT_BYTES=
VOXSENTINEL_MIN_DURATION_S=2
VOXSENTINEL_MAX_DURATION_S=600

# Audio decoding: ffmpeg/ffprobe binaries (M4A/AAC/WebM/Opus). Install the OS
# package; `pip install ffmpeg-python` does not provide the executable. Point
# these at an absolute path if the binaries are not on PATH.
VOXSENTINEL_FFMPEG_BINARY=ffmpeg
VOXSENTINEL_FFPROBE_BINARY=ffprobe

# Phase 5: trained artifact paths (loaded ONLY from these server-side paths,
# and only artifacts produced by this project's training script).
VOXSENTINEL_DETECTOR_MODEL_PATH=models/detector.joblib
VOXSENTINEL_SPEAKER_MODEL_PATH=models/speaker.joblib

# Dataset and report locations (git-ignored; keep datasets and artifacts out of Git).
VOXSENTINEL_DATASET_DIR=data
VOXSENTINEL_REPORT_DIR=reports

# ---------------------------------------------------------------------------
# Phase 6 — External speech generation (Gnani.ai / Vach). All of these are
# BACKEND-ONLY. Never put provider keys in frontend (VITE_*) variables,
# browser JavaScript, or Git. Default: disabled.
# ---------------------------------------------------------------------------
# Set to true only on deployments whose environment can inject the key below.
VOXSENTINEL_GNANI_ENABLED=false
# Placeholder only. The real key is generated at app.gnani.ai and must be
# provided by the deployment platform's environment (or .env, which is
# git-ignored). VOXSENTINEL_GNANI_API_KEY wins over GNANI_API_KEY if both set.
VOXSENTINEL_GNANI_API_KEY=
# Verified official base URL (docs.gnani.ai). HTTPS is enforced in code.
VOXSENTINEL_GNANI_BASE_URL=https://api.vachana.ai
# Bounded network timeouts (seconds).
VOXSENTINEL_GNANI_CONNECT_TIMEOUT_S=5
VOXSENTINEL_GNANI_READ_TIMEOUT_S=30
# Local ceiling on synthesis text length per request.
VOXSENTINEL_GNANI_MAX_TEXT_CHARS=1000
# Abuse/quota protection in front of the provider (per client, per minute/day).
VOXSENTINEL_GNANI_RATE_LIMIT_PER_MINUTE=10
VOXSENTINEL_GNANI_DAILY_QUOTA=200
# Keep generated training samples on disk (with synthetic provenance).
VOXSENTINEL_GNANI_STORE_GENERATED=false
VOXSENTINEL_GNANI_GENERATED_DIR=data/generated/gnani

# ---------------------------------------------------------------------------
# Phase 6C — Self-hosted NVIDIA NemotronLabs VoiceChat 11B (optional).
# This backend talks to YOUR OWN deployment of the official NVIDIA inference
# container (needs an NVIDIA GPU: A100/H100/H200/B100/B200/RTX-6000, Linux).
# No API key: it is private infrastructure. Disabled by default; enabling
# additionally requires VOXSENTINEL_VOICECHAT_WS_URL.
# Non-localhost WebSocket URLs MUST use wss:// (TLS), enforced in code.
# ---------------------------------------------------------------------------
VOXSENTINEL_VOICECHAT_ENABLED=false
# Example: wss://your-gpu-host.example/v1/realtime (ws:// allowed only for localhost)
VOXSENTINEL_VOICECHAT_WS_URL=
# Optional HTTP health probe (GET .../v1/realtime/health of the same container)
VOXSENTINEL_VOICECHAT_HEALTH_URL=
VOXSENTINEL_VOICECHAT_CONNECT_TIMEOUT_S=5
VOXSENTINEL_VOICECHAT_IDLE_TIMEOUT_S=60
# Local cap on input audio per turn (seconds).
VOXSENTINEL_VOICECHAT_MAX_INPUT_SECONDS=60
# Abuse/quota protection (per client, per minute/day).
VOXSENTINEL_VOICECHAT_RATE_LIMIT_PER_MINUTE=5
VOXSENTINEL_VOICECHAT_DAILY_QUOTA=100
# Keep generated agent audio on disk (with synthetic provenance manifest).
VOXSENTINEL_VOICECHAT_STORE_GENERATED=false
VOXSENTINEL_VOICECHAT_GENERATED_DIR=data/generated/voicechat

# ---- Family Emergency & Scam Protection (additive module) ----
# Local multilingual ASR (faster-whisper). No API key, no third-party upload:
# audio is transcribed on this server only.
# Model sizes: tiny (fastest, default) | base | small | medium | large-v3
# Larger models improve Hindi/Hinglish accuracy at the cost of CPU time.
VOXSENTINEL_WHISPER_MODEL=tiny

# ---- Contextual AI classification ----
# PROVIDER: groq | xai | gemini. Leave blank to auto-pick the first configured key.
PROTECTION_LLM_PROVIDER=groq

# Groq (groq.com) — OpenAI-compatible, serves open models. VERIFIED WORKING.
# Keys look like gsk_... (this is NOT an xAI key).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_S=60
GROQ_MAX_TRANSCRIPT_CHARS=6000

# xAI Grok — supported adapter, but requires an xAI key (xai-...) from console.x.ai.
# NOT the same provider as Groq, and not currently configured.

# xAI Grok settings (server-side only).
# NEVER put this key in the frontend or any VITE_* variable.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_TIMEOUT_S=60
XAI_MAX_TRANSCRIPT_CHARS=6000

# ---- Legacy: Gemini contextual scam classification (still supported) ----
# Server-side ONLY. Never set these in the frontend or any VITE_* variable:
# anything prefixed with VITE_ is bundled into the browser build.
# Create a key in Google AI Studio, then set it in the BACKEND environment.
# When unset, the app runs normally on the rule-based baseline and says so
# in the UI, history and export data.
GEMINI_API_KEY=
# Model id served by the Gemini API; keep it current (e.g. gemini-2.5-flash).
GEMINI_MODEL=gemini-3.8-flash
# Request timeout and transcript cap (characters sent to the provider).
GEMINI_TIMEOUT_S=60
GEMINI_MAX_TRANSCRIPT_CHARS=6000

# ---------------------------------------------------------------- unified pipeline
# POST /api/analyze returns transcription + speaker + forensics + scam risk +
# LLM reasoning in one call; GET /api/capabilities reports what is live.
# See docs/UNIFIED_PIPELINE.md.

# --- ASR (whisper-small primary, indicwav2vec-hindi for Hindi, remote fallback)
VOXSENTINEL_ASR_ENGINE=auto
VOXSENTINEL_ASR_FALLBACKS=true
VOXSENTINEL_WHISPER_MODEL=small
VOXSENTINEL_HF_DOWNLOAD=backend/models/hf
# Needed for gated repos such as ai4bharat/indicwav2vec-hindi
HF_TOKEN=
# --- Vach (Gnani) speech-to-text and text-to-speech: ONE backend credential.
# The same value powers POST /stt/v3 (transcription for the family scam
# protection module) and POST /api/v1/tts/inference. Set it in the BACKEND
# environment only: never in the frontend, never in a VITE_* variable, never in
# Git. On the Base44 deployment platform the secret is stored as API_KEY and
# picked up automatically; the names below are optional overrides.
#
# Resolution order (first non-empty wins):
#   VOXSENTINEL_VACH_API_KEY -> VOXSENTINEL_GNANI_API_KEY -> API_KEY -> GNANI_API_KEY
VOXSENTINEL_VACH_API_KEY=
# Shared deployment secret. Setting only this is enough for STT + TTS.
API_KEY=
VOXSENTINEL_VACH_BASE_URL=https://api.vachana.ai
# Request timeout for one transcription call (seconds).
VOXSENTINEL_VACH_STT_TIMEOUT_S=120
# The provider caps audio at 30 s per request; longer calls are chunked to this
# window, preferring pauses so words are not split.
VOXSENTINEL_VACH_STT_MAX_CHUNK_SECONDS=28
# indic-auto = provider-side language detection (en-IN, hi-IN + 10 Indic codes).
# Never use "auto" or "hi-en": the provider rejects those with HTTP 400.
VOXSENTINEL_VACH_STT_LANGUAGE_CODE=indic-auto

# Legacy gRPC/Gnani variables are no longer required. GNANI_ASR_ENDPOINT was an
# unverified guess at an endpoint; the verified path is /stt/v3 and is built in.
GNANI_ASR_ENDPOINT=
GNANI_API_KEY=
GNANI_API_KEY_ID=

# --- Acoustic forensics (detector + handcrafted + wav2vec2-large-xlsr-53)
VOXSENTINEL_FORENSICS_ENABLED=true
# Path to a trained classification head; unset means that branch reports
# "unavailable" and the fused score renormalises over detector + cues.
VOXSENTINEL_FORENSICS_HEAD=
VOXSENTINEL_FORENSICS_THRESHOLD=0.5

# --- Scam text ensemble (MuRIL + DeBERTa heads over the TF-IDF classifier)
VOXSENTINEL_TEXT_ENSEMBLE=true
VOXSENTINEL_TEXT_ENSEMBLE_THRESHOLD=0.55
VOXSENTINEL_TEXT_HEADS_DIR=backend/models/text_heads

# --- LLM threat reasoning: local Ollama model, then Mistral AI cloud fallback
VOXSENTINEL_OLLAMA_URL=http://localhost:11434
VOXSENTINEL_OLLAMA_MODEL=voxisentinel-mistral
VOXSENTINEL_OLLAMA_ENABLED=true
VOXSENTINEL_LLM_FALLBACK=mistral
VOXSENTINEL_LLM_PRIMARY_COOLDOWN_S=60
MISTRAL_API_KEY=
